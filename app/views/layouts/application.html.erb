<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for(:title) || "Student Management System" %></title>
    <meta property="og:title" content="Ruby on Rails Student Management System WebApp" />
    <meta property="og:description" content="A portfolio web application built with Ruby on Rails." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rubyonrails-crudapp.onrender.com/" />
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    
    <%# VITE/REACT INTEGRATION - These 3 tags are required %>
    <%= vite_client_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_javascript_tag 'application.jsx' %>
  </head>

  <body>
    <%# React navigation bar mounts here %>
    <div id="root"></div>

    <%# Rails content goes here %>
    <main class="app-shell">
      <%= yield %>
    </main>
  </body>
</html>
